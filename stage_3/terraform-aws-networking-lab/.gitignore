# Terraform working directory and downloaded providers
.terraform/

# Local state can contain resource attributes and sensitive data
*.tfstate
*.tfstate.*

# Real variable files may contain environment-specific or sensitive values
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Saved plans and crash logs
*.tfplan
crash.log
crash.*.log

# Local CLI configuration
.terraformrc
terraform.rc

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Commit .terraform.lock.hcl after the first successful terraform init.
