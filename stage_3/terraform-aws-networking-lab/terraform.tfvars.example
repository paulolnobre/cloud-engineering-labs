# Copy this file to terraform.tfvars and adjust only the values you need.
# terraform.tfvars is ignored by Git and must never contain AWS credentials.

aws_region         = "us-east-1"
project_name       = "terraform-aws-networking-lab"
environment        = "lab"
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
instance_type      = "t3.micro"

# Inbound access is disabled by default. To enable SSH, set both values below.
# Prefer your own public IPv4 address with a /32 mask; never use 0.0.0.0/0.
# ssh_allowed_cidr = "203.0.113.10/32"
# key_name         = "my-existing-key-pair"
